# Copy this file to .env and fill values before running the app

# Flask secret key
SECRET_KEY=change-me-super-secret

# Database (SQL Server example)
DB_SERVER=localhost
DB_NAME=LuxuryShop
DB_USERNAME=sa
DB_PASSWORD=your_db_password_here
DB_DRIVER=ODBC Driver 17 for SQL Server

# Mail (Gmail example - use app password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-mail-app-password
